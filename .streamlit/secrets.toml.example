# Access control and usage logging are handled by the PW proxy (see pw_access.py).
# No allowed-emails sheet or usage-tracking config is needed here anymore — the
# proxy's "Whitelisted" and "Usage Cost" sheets are the single source of truth.
# Only the Google sign-in config below is required.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
expose_tokens = ["access", "id"]

[auth.google]
client_id = "your-google-oauth-client-id.apps.googleusercontent.com"
client_secret = "your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/spreadsheets" }
