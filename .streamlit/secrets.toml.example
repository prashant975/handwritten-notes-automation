# Access control and usage logging are handled by the PW proxy (see pw_access.py).
# No allowed-emails sheet or usage-tracking config is needed here anymore — the
# proxy's "Whitelisted" and "Usage Cost" sheets are the single source of truth.
# Only the Google sign-in config below is required.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# MUST be a long random string that STAYS THE SAME across restarts. It signs the
# login cookie: change it (or generate a new one at each start) and every user
# is silently logged out on the next restart. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "replace-with-a-long-random-secret"
expose_tokens = ["access", "id"]

[auth.google]
client_id = "your-google-oauth-client-id.apps.googleusercontent.com"
client_secret = "your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile" }

# REQUIRED for a stable session — do not remove.
#
# Streamlit's login cookie lasts 30 days, but the Google id_token inside it
# expires after ~1 hour and Streamlit never renews it. Past that hour the PW
# proxy answers 401 and the app shows "Couldn't verify your access with the PW
# proxy", even though the user is still signed in.
#
# `access_type = "offline"` makes Google return a refresh token, which
# src/pw_auth.py captures and uses to mint a fresh id_token silently — no
# re-login, no page reload. `prompt = "consent select_account"` guarantees a
# refresh token is issued on every interactive sign-in (Google only sends one
# with an explicit consent), so a user who clears local state still recovers.
#
# NOTE: these belong in `authorize_params`, NOT `client_kwargs` — Authlib only
# forwards known OAuth parameters from client_kwargs and silently drops
# `access_type`, which is exactly how this breakage goes unnoticed.
authorize_params = { access_type = "offline", prompt = "consent select_account", include_granted_scopes = "true" }
