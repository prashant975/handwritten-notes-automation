# No AI provider keys are needed. Gemini runs through the shared PW proxy
# (see pw_access.py); the proxy holds the Gemini key. Sign in with your
# @pw.live Google account in the app — that token is all the app uses.

# Legacy single-model settings (still used as the ultimate fallback / for the
# diagram-redraw image model). Model routing below overrides the notes/vision
# model per task and per processing mode.
MODEL_NAME=gemini-3.5-flash
# gemini-3.1-flash-image is the image-capable model on the proxy (the plain
# text models return HTTP 400 for image output). gemini-3-pro-image is the
# slower, higher-quality alternative.
IMAGE_MODEL_NAME=gemini-3.1-flash-image

# ---- App identity (shown in the header + every run_log.json) --------------
APP_VERSION=v2.2.0
APP_TIMEZONE=Asia/Kolkata

# ---- Model routing --------------------------------------------------------
# auto = the app health-checks and picks the best available model per task.
# manual = the user chooses models in the sidebar.
MODEL_ROUTING_MODE=auto
# auto | fast | balanced | high_quality  (default speed mode on load).
# high_quality = notes/vision on Gemini 3.5 Flash, strict equation checks,
# on-demand equation OCR, diagram redraw. auto = health-check then pick Fast/Balanced.
PROCESSING_MODE=high_quality

# Task chains (primary first). Unreleased/unknown IDs are skipped after the
# health check; gemini-3.6-flash (flash backstop) and gemini-2.5-pro (final
# dormant net) are ALWAYS appended, so a model that 404s can never hard-fail
# generation. gemini-2.5-flash has been REMOVED from every chain.
# NOTE (verified against the proxy on 2026-07-25): use the BARE model IDs —
# gemini-3.6-flash / gemini-3.5-flash work; the "-high" suffixed names 404.
# Reasoning depth is a SEPARATE request param (thinkingConfig.thinkingLevel),
# not part of the model id.
# Notes + vision run flash-only: gemini-3.5-flash reads dense handwritten
# equations reliably, is ~2x faster than the Pro model, and does NOT exhaust its
# budget on internal thinking (the Pro empty-response failure); a chunk that
# empties retries on gemini-3.6-flash. FALLBACK_2 is an optional extra model —
# leave it EMPTY (it used to be gemini-2.5-flash, now removed).
NOTES_MODEL_PRIMARY=gemini-3.5-flash
NOTES_MODEL_FALLBACK_1=gemini-3.6-flash
NOTES_MODEL_FALLBACK_2=

VISION_MODEL_PRIMARY=gemini-3.5-flash
VISION_MODEL_FALLBACK_1=gemini-3.6-flash
VISION_MODEL_FALLBACK_2=

QC_MODEL_PRIMARY=gemini-3.5-flash
QC_MODEL_FALLBACK_1=gemini-3.6-flash
QC_MODEL_FALLBACK_2=

# Health-check cache (minutes). Availability is re-tested at most this often.
# Only SUCCESS is cached; a failed probe expires immediately so an outage
# verdict can never pin "No Gemini model is available" for the full TTL.
MODEL_HEALTH_CACHE_MINUTES=15
# false = pin each task to its primary model, no mid-run fallback switching.
MODEL_FALLBACK_ENABLED=true
# (USE_PRO_ONLY_WHEN_NEEDED / IMAGE_ANALYSIS_SELECTIVE /
#  COMPRESS_IMAGES_BEFORE_AI were removed: no code ever read them — selective
#  vision and image compression are always on, and Pro is always last-resort.)

# Shared Gemini resilience controls. Defaults are tuned for SPEED: run several
# chunk calls at once with a short gap (the old 1 / 3s serialized the deck).
# 6-at-once suits the fast flash models — a big deck's ~15 chunks finish in ~3
# waves instead of 5; the retry loop absorbs the occasional 429 this provokes.
GEMINI_MAX_CONCURRENCY=6
GEMINI_REQUEST_DELAY_SECONDS=0.2
GEMINI_MAX_RETRIES=6
GEMINI_RETRY_INITIAL_DELAY_SECONDS=2
GEMINI_RETRY_MAX_DELAY_SECONDS=60
GEMINI_REQUEST_TIMEOUT_SECONDS=120
# Cap on the model's internal "thinking" tokens per note call. Reasoning models
# (Gemini 2.5+/3.x) can otherwise spend the whole output budget thinking about
# image-heavy slides and return an empty response. -1 = no cap (model default).
GEMINI_THINKING_BUDGET=2048
# If a note call STILL returns empty, each retry widens the visible-output budget
# (up to this ceiling) and halves the thinking budget, so even a very dense deck
# converges to real text instead of failing. Keeps generation deck-agnostic.
GEMINI_EMPTY_RETRY_MAX_OUTPUT=32000
ALLOW_GEMINI_FALLBACK=false

# Optional: override the proxy base URL (defaults to the shared proxy).
# PW_PROXY_BASE_URL=https://pw-apps-proxy.vercel.app

RUNS_DIR=runs
OUTPUT_DIR=outputs
APP_NAME=Handwritten Notes Automation

# DEBUG=true also turns on the in-app "Auth debug" panel (auth status, proxy
# status, token expiry, last 401 reason, Force refresh). You can get the same
# panel without restarting by opening http://localhost:8501/?debug=1
DEBUG=false

# ---- Google session / auth refresh (all optional) ------------------------
# Where the captured Google refresh token is stored. Defaults to
# %LOCALAPPDATA%\PWConciseNotes\auth on Windows. DPAPI-encrypted at rest.
# NEVER put this inside a synced/shared folder.
# PW_AUTH_STATE_DIR=

# Where auth_debug.log is written. Defaults to <app root>/logs, falling back to
# the state dir when the app folder is read-only. The packaged app sets this to
# the folder holding runs/ and outputs/.
# PW_AUTH_LOG_DIR=

# Renew the Google id_token when fewer than this many seconds remain (default
# 300). Google id_tokens live ~3600s; raise it if you see expiry races.
# PW_AUTH_REFRESH_SKEW=300
